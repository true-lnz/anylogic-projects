			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778066649109</Id>
					<Name><![CDATA[Retailer_para]]></Name>
					<X>150</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// размер очереди
d_r = Retailer.size();

// сохранение прошлых значений
d_r_1 = d_r;
d_r_2 = d_r_1;
d_r_3 = d_r_2;
d_r_4 = d_r_3;

// до пятой итерации в прошлое (для 2 алгоритма)
d_r_5 = d_r_4;

// проверка: товара на складе больше заказа
if (d_r < s_r) {
    C_r_1 = C_R;
    C_R += d_r * p_r - s_r * k - o_r * p_m;
} else {
    C_r_1 = C_R;
    C_R += d_r * p_r - s_r * k - o_r * p_m;
    C_R -= (d_r - s_r_1) * (1 - q / 100) * p_r;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778067156543</Id>
					<Name><![CDATA[Distibutor_para]]></Name>
					<X>350</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// размер заказа дистрибьютору
d_d = Distributor.size();

// сохранение прошлых значений
d_d_1 = d_d;
d_d_2 = d_d_1;
d_d_3 = d_d_2;
d_d_4 = d_d_3;

// до пятой итерации в прошлое (для 2 алгоритма)
d_d_5 = d_d_4;

// проверка: товара на складе больше заказа
if (d_d < s_d) {
    C_d_1 = C_D;
    C_D += d_d * p_d - s_d * k - o_d * p_m;
} else {
    C_d_1 = C_D;
    C_D += d_d * p_d - s_d * k - o_d * p_m;
    C_D -= (d_d - s_d_1) * (1 - q / 100) * p_d;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778067166973</Id>
					<Name><![CDATA[Distibutor_send]]></Name>
					<X>350</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (mod == 0) {
    // h = 3
    s_r_1 = s_r;
    s_r -= d_r;
    o_r = ((d_r - s_r) + (d_r_1 - s_r) +
           (d_r_2 - s_r) + (d_r_3 - s_r)) / 3;

    if (o_r < 0) {
        o_r = 0;
    }

    s_r += o_r;
} else {
    // h = 5
    s_r -= d_r;
    o_r = ((d_r - s_r) + (d_r_1 - s_r) + (d_r_2 - s_r) +
           (d_r_3 - s_r) + (d_r_4 - s_r) + (d_r_5 - s_r)) / 5;

    if (o_r < 0) {
        o_r = 0;
    }

    s_r += o_r;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1778067183759</Id>
					<Name><![CDATA[Factory_para]]></Name>
					<X>550</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// размер очереди
d_f = Factory.size();

// сохранение прошлых значений
d_f_1 = d_f;
d_f_2 = d_f_1;
d_f_3 = d_f_2;
d_f_4 = d_f_3;

// до пятой итерации в прошлое (для 2-го алгоритма)
d_f_5 = d_f_4;

if (mod == 0) {
    // h = 3
    s_f_1 = s_f;
    s_f -= d_f;
    o_f = ((d_f - s_f) + (d_f_1 - s_f) +
           (d_f_2 - s_f) + (d_f_3 - s_f)) / 3;

    if (o_f < 0) {
        o_f = 0;
    }

    s_f += o_f;
} else {
    // h = 5
    s_f -= d_f;
    o_f = ((d_f - s_f) + (d_f_1 - s_f) + (d_f_2 - s_f) +
           (d_f_3 - s_f) + (d_f_4 - s_f) + (d_f_5 - s_f)) / 5;

    if (o_f < 0) {
        o_f = 0;
    }

    s_f += o_f;
}

if (d_f < s_f) {
    C_f_1 = C_F;
    C_F += d_f * p_f - s_f * k - o_f * p_m;
} else {
    C_f_1 = C_F;
    C_F += d_f * p_f - s_f * k - o_f * p_m;
    C_F -= (d_f - s_f_1) * (1 - q / 100) * p_f;
}]]></Body>
				</Function>
